{
  "name": "@kroescontrol/supermenu",
  "version": "0.4.0",
  "description": "Sites ▾ van Kroescontrol: welke sites iemand ziet, de huidige, en de terugweg naar de hub; Hub en Bedrijf zijn de hub-app; zonder UI en zonder React (prd619, C')",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
